# nzfleet's environment on this machine, written by `nzfleet setup` and read twice: systemd loads it into the
# daemon, and nzfleet loads it for a command typed by hand. Plain KEY=value lines, no quotes, no secrets.
# A line starting with # is unset; remove the # and fill it in. Run `nzfleet setup` again to see what is missing.

# --- Where things live ---------------------------------------------------------------------------------------

# State, logs, batch runs and agent output.
NZFLEET_HOME=@HOME@
# A clone of the repository with an `upstream` remote for nzela-org/nzela. Batches merge PRs in scratch worktrees of it.
NZFLEET_REPO=@REPO@
# Where worktrees are made: agents' (`nzfleet start`) and batches' scratch ones. The tidy pass prunes finished ones here.
NZFLEET_WORK=@WORK@
# nzfleet runs from the checkout named by NZFLEET_CODE, which the daemon moves to main when main's ci is green; `nzfleet version` says what runs and how far behind it is.
# It is a detached worktree of main; the `nzfleet` on PATH is a link into it.
NZFLEET_CODE=@CODE@
# Temporary files of every agent, batch and CI runner the fleet starts, one directory each. Defaults to tmp beside NZFLEET_WORK; keep it off the system disk.
#NZFLEET_TMP=/srv/fleet/tmp
# Cargo build output, in RAM: the disk under NZFLEET_WORK is the bottleneck. The tidy pass removes idle directories here.
#NZFLEET_TARGETS=/dev/shm/nzt
# Where a batch builds. Defaults to /var/tmp/nzt; the tidy pass cleans it as well.
#NZFLEET_TARGET=/var/tmp/nzt

# Warm batch slots: a worktree and build directory per slot that a batch reuses, so it builds only what changed. The
# tidy pass empties a slot's build directory past 80 GB; `rm -rf` a slot's `target` to clear one that has gone bad.
#NZFLEET_WARM=@HOME@/warm
# One compiler cache for the dependencies of every Rust build (capped at 60 GB by sccache, 80 GB by the tidy pass).
#NZFLEET_SCCACHE=@HOME@/sccache
# The cargo registry and npm tarballs batches mount (capped at 20 and 8 GB by the tidy pass).
#NZFLEET_CACHE=@HOME@/cache

# --- GitHub ------------------------------------------------------------------------------------------------

# GitHub login of the fork agents push to, and the author identity of their commits. Sign `gh` in as this account:
# `gh auth login`; the token stays in gh's own store.
#NZFLEET_GIT_NAME=
#NZFLEET_GIT_EMAIL=
# GitHub login whose comments become agent tasks. Empty turns that off.
#NZFLEET_OWNER=
# Upstream repository, if it is not nzela-org/nzela.
#NZFLEET_UPSTREAM=nzela-org/nzela
# A file (mode 0600, outside the repository) holding a fine-grained token with Commit statuses: read and write on the
# upstream repository. Batches post `nzfleet/merge-check` on each head they check with it; empty posts nothing.
#NZFLEET_STATUS_TOKEN_FILE=
# A file (mode 0600, outside the repository) holding a token that can read the repository, for the CI runners' git
# mirror of main. Empty is right for a public repository; without it the mirror is not refreshed on a private one.
#NZFLEET_MIRROR_TOKEN_FILE=

# --- Deployment status -----------------------------------------------------------------------------------

# The gcloud binary, if it is not on PATH.
#NZFLEET_GCLOUD=gcloud
# A service-account key file for the deployer account, if gcloud is not already signed in. Create it for `nzela-deployer`
# in the GCP project, keep it outside the repository with mode 0600, and put only its path here.
#NZFLEET_GCP_KEY=
#NZFLEET_GCP_PROJECT=
#NZFLEET_GCP_REGION=
# Set to 1 to log what Jev would choose beside the supervision and fix rules, which keep acting. NZELA_JEV_KEY_FILE names the key file.
#NZFLEET_JEV_SHADOW=
# Set to 0 to stop Jev acting on the choices whose rollout gates have passed (wait, nudge, rerun, bisect, cache clears); it acts by default.
#NZFLEET_JEV_ACT=
# The API's /health URL, for the status screen.
#NZFLEET_HEALTH_URL=

# --- Agents ----------------------------------------------------------------------------------------------

# A file every agent brief starts with (the rules of the machine: worktrees, ports, databases, pushing).
#NZFLEET_PREAMBLE=
# The agent command, with {model} and {brief} filled in.
#NZFLEET_AGENT=claude -p --model {model} --dangerously-skip-permissions {brief}
# The Codex command used by a `nzfleet session --provider codex` override or a task queued with `--provider codex` or a gpt-* `--model`.
#NZFLEET_AGENT_CODEX=codex exec --model {model} {brief}
# The Claude command used by a `nzfleet session --provider claude` override.
#NZFLEET_AGENT_CLAUDE=claude -p --model {model} --dangerously-skip-permissions {brief}
# The default model for a Codex session; `nzfleet session` also accepts an explicit model override.
#NZFLEET_CODEX_MODEL=gpt-6-luna
# Agents running at once. 0 pauses new starts.
#NZFLEET_AGENT_SLOTS=4
#NZFLEET_BATCH_WALL_CLOCK=28800
# No new work starts above this percentage of the CPU quota the fleet runs under (0 to 100; default 90). Where there
# is no quota to read, the load average is held to the same share of the CPUs. Replaces NZFLEET_MAX_LOAD, which is
# still read, as a load, while this is unset.
#NZFLEET_MAX_CPU_PERCENT=
# Areas whose checks this machine cannot run, so a PR's proof need not include them (formal, image, fuzz).
#NZFLEET_SKIP_AREAS=
# Files `nzfleet train` draws again after merging rather than resolving: a JSON object of path to command. Defaults to generators.json beside the code.
#NZFLEET_GENERATORS=
# notify.py, which emails the owner and no one else. Its credentials live in its own config, not here. Empty sends nothing.
#NZFLEET_OWNER_ISSUE=695
#NZFLEET_NOTIFY=

# --- Build tools -----------------------------------------------------------------------------------------

# What a worktree's shell needs to find cargo, node 22, gcloud and gh. Setup checks each of them.
#PATH=
#CARGO_HOME=
#RUSTUP_HOME=
# The Android SDK.
#ANDROID_HOME=
# A wrapper that waits for one of the machine's Android build slots; the repository ships bin/gradle-slot.
NZFLEET_GRADLE_SLOT=@CODE@/bin/gradle-slot
# psql, if the one on PATH is not new enough to read the migrations.
#NZFLEET_PSQL=psql
# The adb server the phones are plugged into, if it is not this machine's. Setup checks it; empty skips the check.
#NZFLEET_ADB_SERVER=

# --- Disk -------------------------------------------------------------------------------------------------

# Frees disk when / is under 40 GB free, run with `sudo -n`. The administrator allows exactly this command in a file under
# /etc/sudoers.d/ (see the README); `nzfleet setup` prints the install step.

# Cores each owner may use, shown beside what it does use in `nzfleet status`: ci_runners, batches, agents, orchestrator.
#NZFLEET_CPU_QUOTAS=ci_runners=16,batches=24,agents=12

# The port `nzfleet serve` listens on, on the Tailscale address only (default 8787).
#NZFLEET_SERVE_PORT=8787

# --- Phone journeys after a merge ----------------------------------------------------------------------------

# The phone `make journeys` and `make break-it` run on when main moves onto frontend/android or the API the app reads.
# Empty turns the job off. The app is built from main, installed on this one phone, and only its package is touched.
#NZFLEET_JOURNEYS_SERIAL=
#NZFLEET_JOURNEYS_PACKAGE=app.nzela
# The adb server the phone is on, as tcp:<host>:<port>.
#NZFLEET_JOURNEYS_ADB=
# A file holding the Jev key, and a Postgres whose login may create databases, for the run's own lab.
#NZFLEET_JOURNEYS_KEY_FILE=
#NZFLEET_JOURNEYS_DATABASE_URL=
# The lab's first port (it uses four; the phones' host forwards 8080), and the path prefixes a change under which starts a run (comma separated).
#NZFLEET_JOURNEYS_PORT=8080
#NZFLEET_JOURNEYS_PATHS=frontend/android/,crates/nzela/src/api/
# The lock every job that uses a phone or the lab's ports takes; the run holds it from the lab to its teardown.
#NZFLEET_JOURNEYS_LOCK=/tmp/nzela-device.lock
