[Unit]
Description=nzfleet: the status page, on the tailnet only
After=network-online.target tailscaled.service

[Service]
EnvironmentFile=%h/.config/nzfleet/env
ExecStart=/bin/sh -c 'cd "$NZFLEET_CODE" && exec python3 -m nzfleet serve'
# Exits 1 when Tailscale has no address yet; it never falls back to another one.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
